#!/bin/sh
# rust-analyzer for VS Code, as an editor session through the codetags shim
# and lspmux (M3, PLAN.md D22; docs/lsp-shim.md). This repo's
# .vscode/settings.json points rust-analyzer.server.path here.
# tools/lsp/rust-analyzer-shim.sh does the work. On Windows, VS Code starts
# rust-analyzer.exe beside this file instead, a wrapper `just lsp-setup`
# installs (V119).
here=$(cd "$(dirname "$0")" && pwd) || exit 1
exec "$here/../lsp/rust-analyzer-shim.sh" editor "$@"
