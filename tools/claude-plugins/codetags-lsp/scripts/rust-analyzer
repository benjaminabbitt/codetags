#!/bin/sh
# rust-analyzer for Claude Code, as an agent session through the codetags
# shim and lspmux (M3, PLAN.md D16, D18; docs/lsp-shim.md). Claude Code runs
# this as the plugin's language server. tools/lsp/rust-analyzer-shim.sh, in
# the checkout this plugin lives in (it loads in place, V108), does the work.
# On Windows, Claude Code starts rust-analyzer.exe beside this file instead,
# a wrapper `just lsp-setup` installs (V119).
here=$(cd "$(dirname "$0")" && pwd) || exit 1
exec "$here/../../../lsp/rust-analyzer-shim.sh" agent "$@"
